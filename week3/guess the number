#include <iostream>

using namespace std;

int main() {
    int low, high;
    cout << "Enter lower bound: ";
    cin >> low;
    cout << "Enter upper bound: ";
    cin >> high;

    if (low > high) {
        cout << "Invalid range.\n";
        return 1;
    }

    cout << "Use 'h' if my guess is too high, 'l' if too low, and 'c' if correct.\n\n";

    int attempts = 0;
    char feedback;

    while (low <= high) {
        int guess = low + (high - low) / 2;
        attempts++;

        cout << "Attempt " << attempts << ": Is it " << guess << "? (h/l/c): ";
        cin >> feedback;

        if (feedback == 'c' || feedback == 'C') {
            cout << "Found it in " << attempts << " tries!\n";
            break;
        } else if (feedback == 'h' || feedback == 'H') {
            high = guess - 1;
        } else if (feedback == 'l' || feedback == 'L') {
            low = guess + 1;
        } else {
            cout << "Please type h, l, or c.\n";
            attempts--;
        }

        if (low > high) {
            cout << "Contradictory answers detected!\n";
            break;
        }
    }

    return 0;
}
