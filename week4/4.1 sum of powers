#include <iostream>
#include <cmath>
using namespace std;
// header for math operations

double sum_of_powers(double x, double n)
{
double sum =0;
for(int i =1 ; i<=n ; ++i)
{
sum+= std::pow(x, i);
}
return sum;
}

int main()
{
    double a{},b{};
    cout << "please enter your x and n value in order for sum of powers";
    cin >> a >> b;
    cout << sum_of_powers(a,b);
}
